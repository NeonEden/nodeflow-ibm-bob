# ============================================
# WATSONX HACKATHON - ENVIRONMENT VARIABLES
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env (which is in .gitignore)
#    Command: cp .env.example .env
# 2. Replace placeholder values with your actual credentials
# 3. NEVER commit the .env file to git
# 4. NEVER share your credentials in code or with AI assistants
#
# ============================================

# IBM Cloud API Key
# Get from: https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=your_api_key_here_DO_NOT_COMMIT


# ============================================
# SECURITY REMINDERS:
# - This .env.example file is safe to commit
# - Your actual .env file is in .gitignore
# - Never hardcode credentials in your code
# - Use process.env.VARIABLE_NAME to access values
# - Never share credentials with AI assistants like Bob
# ============================================

# ============================================
# NODEFLOW (migrado 26/09/2026) — claves del producto
# ============================================
# Nada de esto se commitea con valor: son nombres, y el .env real está en .gitignore.
# En la app de escritorio las claves viven en el LLAVERO de Windows (src-tauri/src/claves.rs),
# no en este archivo; acá van sólo para correr scripts y la demo desde el repo.

# AssemblyAI — transcripción en vivo (Universal-Streaming v3) + LLM Gateway.
# Ojo: el LLM Gateway de esta cuenta está BLOQUEADO (ver docs/hackathon/pedido-llm-gateway.md).
ASSEMBLYAI_API_KEY=your_assemblyai_key_here_DO_NOT_COMMIT

# Tavily — búsqueda para la investigación por fases (si falta, la investigación cae a Hermes).
TAVILY_API_KEY=your_tavily_key_here_DO_NOT_COMMIT

# Motor de la demo web (server-side; la clave nunca llega al navegador).
DEMO_MOTOR_URL=
DEMO_MOTOR_KEY=
DEMO_MOTOR_MODELO=
